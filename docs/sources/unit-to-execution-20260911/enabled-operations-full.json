[
  {
    "unit_id": "EEG-AUTO-BAD-CHANNEL",
    "op": "detect_bad_channels",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "selection_policy": {
          "const": "consensus_v2",
          "default": "consensus_v2",
          "title": "Selection Policy",
          "type": "string"
        },
        "adaptation_scope": {
          "const": "record_unlabeled",
          "title": "Adaptation Scope",
          "type": "string"
        },
        "window_s": {
          "default": 1,
          "maximum": 5,
          "minimum": 0.5,
          "title": "Window S",
          "type": "number"
        },
        "flat_duration_s": {
          "default": 5,
          "maximum": 30,
          "minimum": 1,
          "title": "Flat Duration S",
          "type": "number"
        },
        "flat_ptp_V": {
          "default": 1e-07,
          "exclusiveMinimum": 0,
          "maximum": 1e-05,
          "title": "Flat Ptp V",
          "type": "number"
        },
        "deviation_z": {
          "default": 5,
          "maximum": 10,
          "minimum": 3,
          "title": "Deviation Z",
          "type": "number"
        },
        "correlation_threshold": {
          "default": 0.4,
          "maximum": 0.8,
          "minimum": 0,
          "title": "Correlation Threshold",
          "type": "number"
        },
        "bad_window_fraction": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Bad Window Fraction",
          "type": "number"
        },
        "persistent_low_corr_fraction": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0.3,
          "title": "Persistent Low Corr Fraction",
          "type": "number"
        },
        "persistent_low_corr_seconds": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "title": "Persistent Low Corr Seconds",
          "type": "number"
        },
        "shared_correlation_threshold": {
          "default": 0.7,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Shared Correlation Threshold",
          "type": "number"
        }
      },
      "required": [
        "adaptation_scope"
      ],
      "title": "DetectBadParams",
      "type": "object"
    },
    "semantics": "Continuous Raw -> unchanged Raw + candidates. Engineering consensus_v2: flat OR amplitude with low correlation OR sustained low correlation. Coherent amplitude outliers are diagnostic only, not certified normal; NOT PREP reproduction. Effective thresholds and channel diagnostic classes are saved. Explicit record_unlabeled transductive adaptation, no class labels. Bind mark_channels.decision_from to this step and use its exact input."
  },
  {
    "unit_id": "EEG-AUTO-BAD-CHANNEL",
    "op": "interpolate_bad_channels",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "max_fraction": {
          "default": 0.1,
          "maximum": 0.25,
          "minimum": 0,
          "title": "Max Fraction",
          "type": "number"
        }
      },
      "title": "InterpolateBadParams",
      "type": "object"
    },
    "semantics": "Continuous Raw -> same grid/physical V. MNE spherical splines repair currently marked EEG only, require head geometry and max_fraction; preserve auxiliary channels and all events/trials. Clear only successfully repaired EEG marks. Place after ASR and before CAR."
  },
  {
    "unit_id": "EEG-ASR-AUTO",
    "op": "asr_clean",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "on_insufficient_calibration": {
          "default": "error",
          "enum": [
            "error",
            "identity"
          ],
          "title": "On Insufficient Calibration",
          "type": "string"
        },
        "adaptation_scope": {
          "const": "record_unlabeled",
          "title": "Adaptation Scope",
          "type": "string"
        },
        "cutoff": {
          "default": 20,
          "maximum": 100,
          "minimum": 10,
          "title": "Cutoff",
          "type": "number"
        },
        "win_len": {
          "default": 0.5,
          "maximum": 2,
          "minimum": 0.5,
          "title": "Win Len",
          "type": "number"
        },
        "win_overlap": {
          "default": 0.66,
          "maximum": 0.9,
          "minimum": 0,
          "title": "Win Overlap",
          "type": "number"
        },
        "min_clean_seconds": {
          "default": 30,
          "minimum": 30,
          "title": "Min Clean Seconds",
          "type": "number"
        },
        "lookahead": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lookahead",
          "type": "number"
        },
        "stepsize": {
          "default": 32,
          "minimum": 1,
          "title": "Stepsize",
          "type": "integer"
        },
        "maxdims": {
          "default": 0.66,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Maxdims",
          "type": "number"
        },
        "mem_splits": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Mem Splits",
          "type": "integer"
        }
      },
      "required": [
        "adaptation_scope"
      ],
      "title": "AsrCleanParams",
      "type": "object"
    },
    "semantics": "ASRpy 0.0.8 Euclidean correction with locally adapted complete-block calibration covariance on unmarked EEG, fixed samples/channels/events. Explicit record_unlabeled transductive calibration, not train-only. Requires full-rank good EEG before CAR/interpolation, high-pass >=0.5 Hz, sufficient clean calibration >=30s, sfreq>82. No EOG/ICA classifier, no time/trial rejection. on_insufficient_calibration defaults to error; explicit identity only handles ASR_CALIBRATION_TOO_SHORT and reports status=not_applicable/asr_applied=false with actual/min seconds. Numerical/rank failures remain errors. Defaults cutoff20, window0.5s require >=1Hz high-pass; calibration mask/matrices and boundary caveat saved."
  },
  {
