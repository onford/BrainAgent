APP_ENV=development

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=brain_agent
MYSQL_PASSWORD=brain_agent
MYSQL_DATABASE=brain_agent
MYSQL_ROOT_PASSWORD=brain_agent_root

# Required. Backend startup fails when this is empty.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Required. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
BRAIN_AGENT_CREDENTIAL_ENCRYPTION_KEY=
DEFAULT_OWNER_ID=local-development-user
EXTERNAL_TOOL_TIMEOUT_SECONDS=10
EXTERNAL_TOOL_MAX_RETRIES=2

BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
